%global debug_package %{nil}
%global upstream_commit @COMMIT@
%global source_sha256 @SOURCE_SHA256@
%global vendor_sha256 @VENDOR_SHA256@
%global toolchain_sha256 @TOOLCHAIN_SHA256@
%if 0%{?fedora} == 44 || 0%{?rhel}
%global bootstrap_go 1
%else
%global bootstrap_go 0
%endif

Name:           mkbrr
Version:        @VERSION@
Release:        @RELEASE@%{?dist}
Summary:        Create, inspect and modify BitTorrent files
License:        @LICENSE@
URL:            https://github.com/autobrr/mkbrr
Source0:        https://codeload.github.com/autobrr/mkbrr/tar.gz/%{upstream_commit}#/mkbrr-%{upstream_commit}.tar.gz
Source1:        mkbrr-%{version}-vendor.tar.gz
Source2:        mkbrr-source-provenance.json
Source3:        https://go.dev/dl/go@TOOLCHAIN_VERSION@.src.tar.gz

%if %{bootstrap_go}
# Bootstrap the newer compiler from source, never download a toolchain binary.
BuildRequires:  golang >= @BOOTSTRAP_VERSION@
BuildRequires:  bash
%else
BuildRequires:  golang >= @GO_VERSION@
%endif
BuildRequires:  coreutils
BuildRequires:  tar
BuildRequires:  gzip
ExclusiveArch:  x86_64 aarch64

%description
mkbrr creates, inspects and modifies .torrent files.
This is an unofficial community build from unmodified upstream source.

%prep
printf '%s  %s\n' '%{source_sha256}' '%{SOURCE0}' | sha256sum --check --status
printf '%s  %s\n' '%{vendor_sha256}' '%{SOURCE1}' | sha256sum --check --status
printf '%s  %s\n' '%{toolchain_sha256}' '%{SOURCE3}' | sha256sum --check --status
%autosetup -n mkbrr-%{upstream_commit}
tar -xzf %{SOURCE1}
cp %{SOURCE2} source-provenance.json
%if %{bootstrap_go}
mkdir .go-toolchain
tar -xzf %{SOURCE3} -C .go-toolchain
%endif

%build
export GOTOOLCHAIN=local GOPROXY=off GOSUMDB=off GOWORK=off CGO_ENABLED=0
export GOCACHE="%{_builddir}/go-cache" GOPATH="%{_builddir}/go-path"
export SOURCE_DATE_EPOCH=@SOURCE_DATE_EPOCH@
%if %{bootstrap_go}
export GOROOT_BOOTSTRAP="$(go env GOROOT)"
(cd .go-toolchain/go/src && ./make.bash)
export PATH="$PWD/.go-toolchain/go/bin:$PATH"
go version | grep -F 'go@TOOLCHAIN_VERSION@ '
cp .go-toolchain/go/LICENSE GOLANG-LICENSE
%else
cp %{_licensedir}/golang/LICENSE GOLANG-LICENSE
%endif
go build -mod=vendor -trimpath -buildvcs=false -pgo=off \
  -ldflags '-s -w -B gobuildid -X main.version=%{version} -X main.buildTime=@BUILD_TIME@' \
  -o mkbrr .

%install
install -Dpm0755 mkbrr %{buildroot}%{_bindir}/mkbrr

%check
export GOTOOLCHAIN=local GOPROXY=off GOSUMDB=off GOWORK=off CGO_ENABLED=0
export GOCACHE="%{_builddir}/go-cache" GOPATH="%{_builddir}/go-path"
%if %{bootstrap_go}
export PATH="$PWD/.go-toolchain/go/bin:$PATH"
%endif
go test -mod=vendor -short ./...
./mkbrr version | grep -F 'mkbrr version: %{version}'

%files
%license LICENSE GOLANG-LICENSE vendor-licenses
%doc README.md source-provenance.json
%{_bindir}/mkbrr

%changelog
* @CHANGELOG_DATE@ Community RPM maintainers - %{version}-@RELEASE@
- Build unmodified upstream source with vendored dependencies.
